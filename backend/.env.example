# Copy this file to .env and fill it in. Never commit .env to GitHub.
# Leave the WhatsApp values empty to use only the simulator page.

# From developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From App settings → Basic → App secret. Turns on signature checking for incoming webhooks.
WHATSAPP_APP_SECRET=
# Any secret word. Type the same word in Meta when you set the webhook.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-secret-word
WHATSAPP_API_VERSION=v23.0

# Optional: an approved Utility template with two variables, {{1}} = ticket id, {{2}} = update text.
# Needed to message citizens more than 24 hours after their last message.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# Optional: path to trained YOLOv8 weights with classes plastic, hyacinth, silt, rubble
MARSHGUARD_YOLO_WEIGHTS=
